# -----------------------------------------------------------------
# FRONTEND CONFIGURATION (REACT_APP_) FOR NETLIFY / PRODUCTION
# -----------------------------------------------------------------

# API URL: URL of your backend hosted on Render.com (or elsewhere)
# Replace with your actual backend URL: e.g., https://your-backend-app.onrender.com
REACT_APP_API_URL=https://YOUR-BACKEND-URL.onrender.com

# Disable source maps in production build (improves build speed and reduces bundle size)
GENERATE_SOURCEMAP=false
